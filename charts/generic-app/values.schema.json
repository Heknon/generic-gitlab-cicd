{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "apps"
  ],
  "properties": {
    "apps": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9-]{0,18}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "image",
          "replicas",
          "config",
          "resources",
          "readinessProbe",
          "service"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "replicas": {
            "type": "integer",
            "minimum": 1
          },
          "image": {
            "type": "object",
            "required": [
              "repository",
              "tag"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "tag": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "config": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "resources": {
            "type": "object",
            "required": [
              "requests",
              "limits"
            ]
          },
          "readinessProbe": {
            "type": "object",
            "minProperties": 1,
            "oneOf": [
              {
                "required": [
                  "httpGet"
                ]
              },
              {
                "required": [
                  "exec"
                ]
              },
              {
                "required": [
                  "tcpSocket"
                ]
              },
              {
                "required": [
                  "grpc"
                ]
              }
            ]
          },
          "service": {
            "type": "object",
            "required": [
              "enabled",
              "port",
              "targetPort"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "targetPort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          },
          "route": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "host": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "annotations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "wildcardPolicy": {
                "type": "string"
              },
              "tls": {
                "type": "object",
                "properties": {
                  "termination": {
                    "type": "string"
                  },
                  "insecureEdgeTerminationPolicy": {
                    "type": "string"
                  },
                  "certificate": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "caCertificate": {
                    "type": "string"
                  },
                  "destinationCACertificate": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    }
  }
}
