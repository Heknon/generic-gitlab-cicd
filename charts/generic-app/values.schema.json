{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "apps"
  ],
  "properties": {
    "apps": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9-]{0,18}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "image",
          "replicas",
          "config",
          "service"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "replicas": {
            "type": "integer",
            "minimum": 1
          },
          "image": {
            "type": "object",
            "required": [
              "repository",
              "tag"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "tag": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "config": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "resources": {
            "type": "object"
          },
          "readinessProbe": {
            "type": "object"
          },
          "service": {
            "type": "object",
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "targetPort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "annotations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "route": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "host": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "annotations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "wildcardPolicy": {
                "type": "string"
              },
              "tls": {
                "type": "object",
                "properties": {
                  "termination": {
                    "type": "string"
                  },
                  "insecureEdgeTerminationPolicy": {
                    "type": "string"
                  },
                  "certificate": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "caCertificate": {
                    "type": "string"
                  },
                  "destinationCACertificate": {
                    "type": "string"
                  }
                }
              },
              "targetPort": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            }
          },
          "livenessProbe": {
            "type": "object"
          },
          "startupProbe": {
            "type": "object"
          },
          "podSecurityContext": {
            "type": "object"
          },
          "securityContext": {
            "type": "object"
          },
          "automountServiceAccountToken": {
            "type": "boolean"
          },
          "volumes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "volumeMounts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "podLabels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "podAnnotations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    }
  }
}
