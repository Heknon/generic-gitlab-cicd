{
  "$defs": {
    "Builder": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "const": "buildah",
          "default": "buildah",
          "title": "Engine",
          "type": "string"
        },
        "image": {
          "title": "Image",
          "type": "string"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        }
      },
      "required": [
        "image"
      ],
      "title": "Builder",
      "type": "object"
    },
    "Cache": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/CacheKey"
            }
          ],
          "title": "Key"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "policy": {
          "default": "pull-push",
          "enum": [
            "pull",
            "push",
            "pull-push"
          ],
          "title": "Policy",
          "type": "string"
        }
      },
      "required": [
        "key",
        "paths"
      ],
      "title": "Cache",
      "type": "object"
    },
    "CacheKey": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefix"
        }
      },
      "required": [
        "files"
      ],
      "title": "CacheKey",
      "type": "object"
    },
    "Execution": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        },
        "variables": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Variables",
          "type": "object"
        },
        "services": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Services"
        },
        "parallel": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parallel"
        },
        "artifacts": {
          "additionalProperties": true,
          "title": "Artifacts",
          "type": "object"
        },
        "cache": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cache"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Native GitLab cache mapping; paths are repository-relative. Cache downloads, not prepared environments or receipts."
        }
      },
      "title": "Execution",
      "type": "object"
    },
    "Registries": {
      "additionalProperties": false,
      "properties": {
        "containers": {
          "title": "Containers",
          "type": "string"
        },
        "previews": {
          "title": "Previews",
          "type": "string"
        }
      },
      "required": [
        "containers",
        "previews"
      ],
      "title": "Registries",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "kubeconfig-variable": {
          "default": "KUBECONFIG",
          "title": "Kubeconfig-Variable",
          "type": "string"
        },
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        },
        "production": {
          "default": true,
          "title": "Production",
          "type": "boolean"
        },
        "release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release"
        }
      },
      "required": [
        "namespace"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "defaults": {
      "$ref": "#/$defs/Execution"
    },
    "images": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Prepared images for python, node, bun, helm, and optional control role; all include toolkit Python runtime.",
      "title": "Images",
      "type": "object"
    },
    "container-builder": {
      "anyOf": [
        {
          "$ref": "#/$defs/Builder"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "registries": {
      "anyOf": [
        {
          "$ref": "#/$defs/Registries"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "allowed-hosts": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed-Hosts",
      "type": "array"
    },
    "targets": {
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,39}$": {
          "$ref": "#/$defs/Target"
        }
      },
      "title": "Targets",
      "type": "object"
    },
    "variables": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Variables",
      "type": "object"
    },
    "max-jobs": {
      "default": 150,
      "maximum": 1000,
      "minimum": 1,
      "title": "Max-Jobs",
      "type": "integer"
    }
  },
  "required": [
    "images",
    "allowed-hosts"
  ],
  "title": "Platform",
  "type": "object"
}
